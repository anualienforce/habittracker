name: Build iOS Simulator App

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build-ios:
    name: Build iOS App for Simulator
    runs-on: macos-14

    steps:
      # 1️⃣ Checkout repository
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2️⃣ Set up Flutter (with caching)
      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.35.6'
          cache: true

      # 3️⃣ Check Flutter version
      - name: Check Flutter version
        run: flutter --version

      # 4️⃣ Check Xcode version
      - name: Check Xcode version
        run: xcodebuild -version

      # 5️⃣ Cache CocoaPods
      - name: Cache CocoaPods
        uses: actions/cache@v4
        with:
          path: ios/Pods
          key: pods-${{ hashFiles('ios/Podfile.lock') }}
          restore-keys: pods-

      # 6️⃣ Install Flutter dependencies
      - name: Flutter pub get
        run: flutter pub get

      # 7️⃣ Clean and re-install Pods
      - name: Clean and re-install Pods
        run: |
          cd ios
          rm -rf Pods
          rm -f Podfile.lock
          pod repo update
          pod install
          cd ..

      # 8️⃣ Debug: search for bridging headers & Swift module maps
      - name: Debug: Check bridging headers
        run: |
          echo "=== Searching for bridging headers ==="
          find ios -name "*Bridging-Header.h"
          echo "=== Listing Swift modulemap files ==="
          find ios -name "module.modulemap"
          echo "=== Checking Build Settings for Bridging Headers ==="
          xcodebuild -showBuildSettings | grep SWIFT_OBJC_BRIDGING_HEADER || true

      # 9️⃣ Auto-remove unused bridging header (fix for Xcode 16)
      - name: Detect and remove unused bridging header
        run: |
          echo "=== Checking for Runner-Bridging-Header.h ==="
          if [ -f "ios/Runner/Runner-Bridging-Header.h" ]; then
            echo "Found bridging header. Checking if it's actually used..."
            USED_COUNT=$(grep -R "Runner-Bridging-Header.h" ios/Runner.xcodeproj 2>/dev/null | wc -l)
            if [ "$USED_COUNT" -eq 0 ]; then
              echo "⚙️ Not referenced in project. Removing bridging header..."
              rm ios/Runner/Runner-Bridging-Header.h
              echo "✅ Removed unused bridging header"
            else
              echo "ℹ️ Bridging header is still referenced ($USED_COUNT matches). Keeping it."
            fi
          else
            echo "✅ No bridging header found. Skipping."
          fi

      # 🔟 Build iOS app for Simulator
      - name: Build iOS Simulator app
        run: flutter build ios --simulator --no-codesign

      # 1️⃣1️⃣ List build output
      - name: List build artifacts
        run: ls -R build/ios/iphonesimulator

      # 1️⃣2️⃣ Upload .app as artifact
      - name: Upload .app artifact
        uses: actions/upload-artifact@v4
        with:
          name: ios-simulator-app
          path: build/ios/iphonesimulator/*.app
