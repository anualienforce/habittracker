platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'
ENV['SWIFT_ALLOW_BRIDGING_HEADER'] = 'NO'
ENV['SWIFT_USE_INTEGRATED_DRIVER'] = 'YES'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Find Flutter root
def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}"
end

require File.expand_path(File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb'))

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# -------------------- FINAL, DEFINITIVE POST_INSTALL SCRIPT (v4) --------------------
# This script runs after pods are installed and forcefully corrects build
# settings for the main project, test targets, and all pod dependencies
# to resolve persistent build and linker errors in CI/CD environments.
post_install do |installer|

  # --- Section 1: Forcefully correct the main project targets (Runner, RunnerTests) ---
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|

        # a) Fix the "bridging headers" error
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'

        # b) Silence Bitcode warnings (deprecated)
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'

        # c) Fix "Undefined symbol" linker errors by inheriting search paths
        config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = [
            '$(inherited)',
            '@executable_path/Frameworks',
        ]

        # --- THIS IS THE NEW FIX FOR "No such module 'Flutter'" ---
        # d) It corrects the Framework Search Paths to find the Flutter engine.
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] = [
          '$(inherited)',
          '$(PROJECT_DIR)/Flutter', # Path to the Flutter framework
        ]

      end
    end
  end

  # --- Section 2: Forcefully correct all Pod dependency targets ---
  installer.pods_project.targets.each do |target|
      flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # a) Fix the "bridging headers" error
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      # b) Silence Bitcode warnings (deprecated)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
    end
  end

  # --- Section 3: Specific workaround for IosAwnCore plugin (if needed) ---
  begin
    ios_aw_core_files = Dir["#{installer.sandbox.pod_dir('IosAwnCore')}/IosAwnCore/Classes/**/*.swift"]
    ios_aw_core_files.each do |file|
      content = File.read(file)
      new_content = ""
      new_content += "import UIKit\n" unless content.include?("import UIKit")
      new_content += "import UserNotifications\n" unless content.include?("import UserNotifications")
      new_content += content
      File.write(file, new_content)
    end
  rescue => e
    puts "Skipping IosAwnCore auto-import fix: #{e.message}"
  end

end